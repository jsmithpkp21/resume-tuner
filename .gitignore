# Virtual environments
venv/
.env/
.venv/
*.venv/

# Environment overrides
.env.local

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
# Editable-install metadata (regenerated by `pip install -e .`; #41 layout)
*.egg-info/

# Node dependencies (markdownlint/npm local installs)
node_modules/

# JetBrains / PyCharm
.idea/

# OS junk
.DS_Store
Thumbs.db

# Swap files (nano/vim)
*.swp
*.swo

# Sandbox
sandbox/

# Generated review artifacts
data/review/
# Personal profile data (single-file model; copy data/profile/profile.example.toml to seed)
data/profile/profile.toml
# Personal job-application research artifacts (recording-protocol notes, answer bank, screening Qs)
data/applications/
# Legacy explicit entries kept for readability while migrating review outputs to sandbox
data/review/packets/
# Visual diff working files (regenerated each run)
data/review/outputs/visual_diff/

# Root-level company-specific artifacts should stay out of git history
/GRAPHCORE_*
/README_GRAPHCORE.md
/graphcore_resume.*
/e2e_schwab_test.py

# Block root-level generated/source artifacts by file type
/*.py
/*.html
/*.docx
/*.pdf

# Local session context (never commit)
CONTEXT_LOCAL.md
