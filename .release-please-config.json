{
  "release-type": "python",
  "packages": {
    ".": {
      "package-name": "resume-builder",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION",
          "glob": false
        },
        {
          "type": "toml",
          "path": ".pyproject.meta.toml",
          "jsonpath": "$.project.version"
        }
      ]
    }
  }
}
