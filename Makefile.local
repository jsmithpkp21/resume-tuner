# Makefile.local — consumer-side targets that extend the synced Makefile.
#
# The synced `Makefile` ends with `-include Makefile.local`, so any
# target defined here is available alongside the tooling-provided
# targets. Per AGENTS.md / docs/REFERENCE/adr/0001 this file MUST NOT
# be added to `.tooling-sync-manifest.toml` — it's consumer-owned and
# would otherwise be overwritten by sync.

# ---------------------------------------------------------------------
# Pre-push quality gates (PR #364 retrospective)
# ---------------------------------------------------------------------
#
# These catch two friction modes seen in the PR #364 review cycle that
# `make lint` (ruff + mypy + markdown-lint) didn't surface:
#
#   - `make doc-drift-check`     — scans for deny-listed API references
#       in docstrings and comments (e.g. `page.fill` when the code
#       uses `Locator.press_sequentially`). Fails on hit; the script
#       supports `# noqa: doc-drift` opt-out per line.
#   - `make no-new-type-ignore`  — scans staged-for-commit Python
#       changes for newly-added `# type: ignore` comments. Exits 1
#       on hit so the user can either annotate the surrounding
#       container or commit with `--no-verify` for genuinely
#       irreducible cases.
#
# These are make targets only; they are NOT installed as
# `.pre-commit-config.yaml` hooks (that file is tooling-synced;
# consumer additions would drift). `make pre-push-checks` bundles
# both so a single command runs the consumer-specific gates that
# aren't in `make lint`.

.PHONY: doc-drift-check no-new-type-ignore pre-push-checks

# Both gates run inside the project venv so the same Python that
# powers `make lint` / `make test` runs the checks. Matches the
# `bash -lc "source $(ENV_PATH)/bin/activate && ..."` pattern the
# synced Makefile uses everywhere else; `$(ENV_PATH)` is exported by
# the synced Makefile and resolves to `~/envs/<repo>-env`.

doc-drift-check:
	bash -lc "source \"$(ENV_PATH)/bin/activate\" && python3 scripts/check_doc_drift.py"

no-new-type-ignore:
	bash -lc "source \"$(ENV_PATH)/bin/activate\" && python3 scripts/check_no_type_ignore.py"

pre-push-checks: doc-drift-check no-new-type-ignore
	@echo "[pre-push-checks] all consumer-side gates passed"
