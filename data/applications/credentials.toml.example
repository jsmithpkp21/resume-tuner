# data/applications/credentials.toml — per-ATS credential store
#
# Copy this file to `credentials.toml` (same directory) and fill in real
# values. The whole `data/applications/` directory is gitignored except
# for this committed template (`!data/applications/credentials.toml.example`
# in .gitignore); the real `credentials.toml` stays ignored. NEVER commit
# a populated credentials.toml.
#
# Security posture: plain TOML on disk, chmod 0600 on write. There is no
# encryption at rest — filesystem permissions plus gitignore are the only
# barriers. This matches the existing `data/profile/profile.toml` posture.
# See issue #333 for the rationale and explicitly out-of-scope items
# (encryption, OS keychain, master-password KDF).
#
# Programmatic access lives in `src/resume_builder/credential_store.py`:
#   from resume_builder.credential_store import lookup, record
#   entry = lookup("workday", "becu")        # -> dict or None
#   record("workday", "becu", "user@x", "pw")
#
# Display-only contract: integrations (e.g. record_session / fill_session
# from issue #319) MUST surface the looked-up password to the user and
# let them type it. Do not autofill — see issue #333 threat-model notes.

[ats.workday.becu]
tenant_url = "https://becu.wd1.myworkdayjobs.com/External"
username = "your_email@example.com"
password = "replace-with-memorable-password"
created = 2026-05-11
notes = "Example entry — replace with real values"

